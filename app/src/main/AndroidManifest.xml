            isClickable = true
            setOnClickListener { cb() }
        }
        box.addView(btn("−", onMinus))
        box.addView(tv("$q", 15f, INK, true).apply {
            gravity = Gravity.CENTER
            minimumWidth = dp(26)
        })
        box.addView(btn("+", onPlus))
        return box
    }

