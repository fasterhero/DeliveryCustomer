                    lines.addView(View(this).apply { setBackgroundColor(LINE) }, lp(MATCH, 1))
                }
            }
            page.addView(lines, lp(MATCH, WRAP))

            // Promo
            sectionTitle(page, "Promo code")
            val code = promoCode
            if (code != null) {
