            chipRow.removeAllViews()
            for ((key, icon, label) in categories) {
                val selected = key == selectedCategory
                val item = vbox().apply {
                    gravity = Gravity.CENTER
                    setPadding(dp(6), dp(4), dp(6), dp(4))
                    isClickable = true
                    setOnClickListener {
                        if (key == "parcel" || key == "pabili") {
